<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mecanum_bot">

  <xacro:include filename="$(find first_urdf)/urdf/mecanum_wheel.xacro" />

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.20 0.15 0.08" />
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.20 0.15 0.08" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8" />
     
      <inertia ixx="0.019267" ixy="0.0" ixz="0.0" iyy="0.030933" iyz="0.0" izz="0.041667" />
    </inertial>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <gravity>true</gravity>
  </gazebo>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>

  <link name="laser_frame">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.03"/>
      </geometry>
      <material name="green"> 
        <color rgba="0.0 1.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.03"/>
      </geometry>
    </collision>
  </link>

  <joint name="laser_joint" type="fixed">
      <parent link="base_link"/>
      <child link="laser_frame"/>
      <origin xyz="0 0 0.055" rpy="0 0 0"/>
  </joint>

  <gazebo reference="laser_frame">
    <sensor name="laser" type="ray">
      <pose> 0 0 0 0 0 0 </pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <min_angle>-3.14</min_angle>
            <max_angle>3.14</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>6.0</max>
        </range>
      </ray>
      <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <argument>~/out:=scan</argument> <!--This is remapping from the out topic of the controller to scan topic-->
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_frame</frame_name>
      </plugin>
    </sensor>
    <material>Gazebo/Green</material>
  </gazebo>

  <xacro:property name="wheel_stance" value="0.095" />
  <xacro:property name="wheel_z" value="-0.037" />
  
  <xacro:mecanum_wheel prefix="front_left"  parent="base_link"
    xyz="${wheel_stance} ${wheel_stance} ${wheel_z}"
    roll_sign="1"   hub_sign="1"  mesh_pkg="first_urdf" />
  <xacro:mecanum_wheel prefix="front_right" parent="base_link"
    xyz="${wheel_stance} ${-wheel_stance} ${wheel_z}"
    roll_sign="-1"  hub_sign="-1" mesh_pkg="first_urdf" />
  <xacro:mecanum_wheel prefix="rear_left"   parent="base_link"
    xyz="${-wheel_stance} ${wheel_stance} ${wheel_z}"
    roll_sign="-1"  hub_sign="-1" mesh_pkg="first_urdf" />
  <xacro:mecanum_wheel prefix="rear_right"  parent="base_link"
    xyz="${-wheel_stance} ${-wheel_stance} ${wheel_z}"
    roll_sign="1"   hub_sign="1"  mesh_pkg="first_urdf" />

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"><param name="min">-5</param><param name="max">5</param></command_interface>
      <param name="vel_kp">2.0</param><param name="vel_ki">5.0</param><param name="vel_kd">0.0</param><param name="vel_max_integral_error">5.0</param>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"><param name="min">-5</param><param name="max">5</param></command_interface>
      <param name="vel_kp">2.0</param><param name="vel_ki">5.0</param><param name="vel_kd">0.0</param><param name="vel_max_integral_error">5.0</param>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"><param name="min">-5</param><param name="max">5</param></command_interface>
      <param name="vel_kp">2.0</param><param name="vel_ki">5.0</param><param name="vel_kd">0.0</param><param name="vel_max_integral_error">5.0</param>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"><param name="min">-5</param><param name="max">5</param></command_interface>
      <param name="vel_kp">2.0</param><param name="vel_ki">5.0</param><param name="vel_kd">0.0</param><param name="vel_max_integral_error">5.0</param>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
  </ros2_control>


  <!--mecanum_drive_controller was publishing to its own private topic called odometry with its own prefix. While Rviz listens to only global topics, so had to remap to odom for frame and tf for transform.-->
  <!--Earlier I remapped to mecanum_controller_spawner_node which didn't work because it is a shortlived node. Moral of the story, never remap in spawner, the same was for reference_unstamped remapping.-->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(find first_urdf)/config/mecanum_controllers.yaml</parameters>
      <ros>
        <remapping>/mecanum_drive_controller/tf_odometry:=/tf</remapping>
        <remapping>/mecanum_drive_controller/odometry:=/odom</remapping>
      </ros>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <robot_param_type>topic</robot_param_type>
    </plugin>
  </gazebo>
</robot>