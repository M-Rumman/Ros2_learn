<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mecanum_bot">

  <!-- Include your optimized wheel macro file -->
  <xacro:include filename="$(find first_urdf)/urdf/mecanum_wheel.xacro" />

  <!-- Base Link Box (Adjusted for 400g scale) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <!-- Scaled down from 1m to 20cm x 15cm x 8cm to reflect your 400g chassis scale -->
        <box size="0.20 0.15 0.08" />
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 0.5 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <box size="0.20 0.15 0.08" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="0.4" />
      <inertia ixx="0.000963" ixy="0.0" ixz="0.0" iyy="0.001547" iyz="0.0" izz="0.002083" />
    </inertial>
  </link>

  <!-- Gazebo needs its own material tag; the URDF <material><color> above is only
       honored by RViz. Without this, Gazebo renders base_link with its default
       gray material regardless of what color you set above. -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- Mounting Wheels at the corner coordinates (Adjusted offsets for smaller chassis) -->
  <xacro:mecanum_wheel prefix="front_left"  parent="base_link" xyz="0.06 0.11 0.0"  rpy="0 0 0" roll_sign="-1" />
  <xacro:mecanum_wheel prefix="front_right" parent="base_link" xyz="0.06 -0.06 0.0" rpy="0 0 0" roll_sign="1" />
  <xacro:mecanum_wheel prefix="rear_left"   parent="base_link" xyz="-0.11 0.11 0.0"  rpy="0 0 0" roll_sign="1" />
  <xacro:mecanum_wheel prefix="rear_right"  parent="base_link" xyz="-0.11 -0.06 0.0" rpy="0 0 0" roll_sign="-1" />

  <!-- ros2_control configuration -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"><param name="min">-10</param><param name="max">10</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"><param name="min">-10</param><param name="max">10</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"><param name="min">-10</param><param name="max">10</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"><param name="min">-10</param><param name="max">10</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(find first_urdf)/config/mecanum_controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
