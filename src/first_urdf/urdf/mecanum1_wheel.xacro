<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="mecanum_roller" params="parent theta radius width offset roller_idx roll_sign">
    <link name="${parent}_roller_${roller_idx}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder radius="${radius}" length="${width}" />
        </geometry>
        <material name="dark_grey">
          <color rgba="0.2 0.2 0.2 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder radius="${radius}" length="${width}" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1" /> 
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0002" />
      </inertial>
    </link>

    <joint name="${parent}_roller_${roller_idx}_joint" type="continuous">
      <parent link="${parent}" />
      <child link="${parent}_roller_${roller_idx}" />
      <origin xyz="${offset * cos(theta)} ${offset * sin(theta)} 0" 
              rpy="${roll_sign * 0.785398} ${-theta} 0" />
      <axis xyz="0 0 1" />
      <dynamics damping="0.005" friction="0.01"/>
    </joint>

    <gazebo reference="${parent}_roller_${roller_idx}">
      <material>Gazebo/DarkGrey</material>
      <mu1 value="1.5" />
      <mu2 value="1.5" />
      <kp value="100000.0" /> 
      <kd value="10.0" />     
      <minDepth value="0.005" />
      <maxVel value="0.05" />
    </gazebo>
  </xacro:macro>

  <xacro:macro name="mecanum_wheel" params="prefix parent xyz rpy roll_sign">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.15" length="0.08" />
        </geometry>
        <material name="blue">
          <color rgba="0.1 0.4 0.8 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.12" length="0.07" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.8" />
        <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.009" />
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${parent}" />
      <child link="${prefix}_wheel_link" />
      <origin xyz="${xyz}" rpy="${rpy}" />
      <axis xyz="0 0 1" />
      <dynamics damping="0.01" friction="0.05"/>
    </joint>

    <xacro:mecanum_roller parent="${prefix}_wheel_link" theta="0.0"          radius="0.035" width="0.07" offset="0.13" roller_idx="1"  roll_sign="${roll_sign}"/>
    <xacro:mecanum_roller parent="${prefix}_wheel_link" theta="0.523598"     radius="0.035" width="0.07" offset="0.13" roller_idx="2"  roll_sign="${roll_sign}"/>
    <xacro:mecanum_roller parent="${prefix}_wheel_link" theta="1.047197"     radius="0.035" width="0.07" offset="0.13" roller_idx="3"  roll_sign="${roll_sign}"/>
    <xacro:mecanum_roller parent="${prefix}_wheel_link" theta="1.570796"     radius="0.035" width="0.07" offset="0.13" roller_idx="4"  roll_sign="${roll_sign}"/>
    <xacro:mecanum_roller parent="${prefix}_wheel_link" theta="2.094395"     radius="0.035" width="0.07" offset="0.13" roller_idx="5"  roll_sign="${roll_sign}"/>
    <xacro:mecanum_roller parent="${prefix}_wheel_link" theta="2.617993"     radius="0.035" width="0.07" offset="0.13" roller_idx="6"  roll_sign="${roll_sign}"/>
    <xacro:mecanum_roller parent="${prefix}_wheel_link" theta="3.141592"     radius="0.035" width="0.07" offset="0.13" roller_idx="7"  roll_sign="${roll_sign}"/>
    <xacro:mecanum_roller parent="${prefix}_wheel_link" theta="3.665191"     radius="0.035" width="0.07" offset="0.13" roller_idx="8"  roll_sign="${roll_sign}"/>
    <xacro:mecanum_roller parent="${prefix}_wheel_link" theta="4.188790"     radius="0.035" width="0.07" offset="0.13" roller_idx="9"  roll_sign="${roll_sign}"/>
    <xacro:mecanum_roller parent="${prefix}_wheel_link" theta="4.712388"     radius="0.035" width="0.07" offset="0.13" roller_idx="10" roll_sign="${roll_sign}"/>
    <xacro:mecanum_roller parent="${prefix}_wheel_link" theta="5.235987"     radius="0.035" width="0.07" offset="0.13" roller_idx="11" roll_sign="${roll_sign}"/>
    <xacro:mecanum_roller parent="${prefix}_wheel_link" theta="5.759586"     radius="0.035" width="0.07" offset="0.13" roller_idx="12" roll_sign="${roll_sign}"/>

    <gazebo reference="${prefix}_wheel_link">
      <material>Gazebo/Blue</material>
    </gazebo>
  </xacro:macro>
</robot>