<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org">

  <!-- Automated Roller Loop Generator -->
  <xacro:macro name="roller_loop" params="parent num total offset roll_sign">
    <xacro:if value="${num &lt;= total}">
      <xacro:property name="theta" value="${(num - 1) * (2 * 3.1415926535 / total)}"/>
      
      <link name="${parent}_roller_${num}">
        <visual>
          <!-- Reset to 0 0 0: let the joint's roll_sign*45deg + theta sweep
               fully control roller orientation, rather than pre-rotating the
               mesh here (which was fighting the joint math and producing a
               flat "spoke" look instead of a tangent/angled roller). -->
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <!-- Clean STL path -->
            <mesh filename="package://first_urdf/meshes/mecanum_roller.STL" scale="1 1 1"/>
          </geometry>
          <material name="red">
            <color rgba="1.0 0.0 0.0 1.0" />
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <cylinder radius="0.0065" length="0.028" />
          </geometry>
        </collision>
        <inertial>
          <!-- Increased slightly above strict physics to prevent ODE mesh culling -->
          <mass value="0.01" /> 
          <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001" />
        </inertial>
      </link>

      <joint name="${parent}_roller_${num}_joint" type="continuous">
        <parent link="${parent}" />
        <child link="${parent}_roller_${num}" />
        <origin xyz="${offset * cos(theta)} ${offset * sin(theta)} 0" 
                rpy="${roll_sign * 0.785398} ${-theta} 0" />
        <axis xyz="0 0 1" />
        <dynamics damping="0.001" friction="0.002"/>
      </joint>

      <gazebo reference="${parent}_roller_${num}">
        <material>Gazebo/Red</material>
        <mu1 value="2.0" />
        <mu2 value="2.0" />
        <kp value="1000000.0" /> 
        <kd value="100.0" />     
        <minDepth value="0.001" />
        <maxVel value="0.1" />
      </gazebo>

      <xacro:roller_loop parent="${parent}" num="${num + 1}" total="${total}" offset="${offset}" roll_sign="${roll_sign}" />
    </xacro:if>
  </xacro:macro>

  <!-- Main Hub Instantiation Macro -->
  <xacro:macro name="mecanum_wheel" params="prefix parent xyz rpy roll_sign">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0" />
        <geometry>
          <mesh filename="package://first_urdf/meshes/mecanum_hub.STL" scale="1 1 1"/>
        </geometry>
        <material name="yellow">
          <color rgba="1.0 0.85 0.0 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.04" length="0.035" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05" />
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${parent}" />
      <child link="${prefix}_wheel_link" />
      <origin xyz="${xyz}" rpy="${rpy}" />
      <axis xyz="0 0 1" />
      <dynamics damping="0.005" friction="0.01"/>
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <material>Gazebo/Yellow</material>
    </gazebo>

    <xacro:roller_loop parent="${prefix}_wheel_link" num="1" total="8" offset="0.035" roll_sign="${roll_sign}"/>
  </xacro:macro>
</robot>
