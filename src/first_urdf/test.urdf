      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0002"/>
    </inertial>
  </link>
  <!-- Continuous joint to let the passive roller spin freely -->
  <joint name="rear_right_wheel_link_roller_12_joint" type="continuous">
    <parent link="rear_right_wheel_link"/>
    <child link="rear_right_wheel_link_roller_12"/>
    <!-- Swapped -theta from Pitch to Yaw to keep rollers perfectly tangential -->
    <origin rpy="-0.785398 0 5.759586531581287" xyz="0.12990381056766576 -0.07500000000000007 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.005" friction="0.01"/>
  </joint>
  <gazebo reference="rear_right_wheel_link_roller_12">
    <material>Gazebo/DarkGrey</material>
    <mu1 value="1.2"/>
    <!-- 1. Slightly lower from 1.5 to allow smooth transitions -->
    <mu2 value="1.2"/>
    <kp value="50000.0"/>
    <!-- Halved from 100000.0 to let rollers squash by a fraction of a millimeter -->
    <kd value="50.0"/>
    <!-- Increased from 10.0 to act as a shock absorber during handoffs -->
    <minDepth value="0.008"/>
    <!-- Raised slightly from 0.005 -->
    <maxVel value="0.01"/>
    <!-- Lowered from 0.05 to cap the maximum velocity correction speed -->
  </gazebo>
  <gazebo reference="rear_right_wheel_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <!-- ros2_control configuration -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>/home/rumman/ros2_ws/install/first_urdf/share/first_urdf/config/mecanum_controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
